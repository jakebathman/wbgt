APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Perry Weather station used for the MSA column (the field weather boxes MSA makes heat decisions from).
# Location IDs for McKinney fields (from the widget on each parks.mckinneytexas.org park page):
#   Al Ruschhaupt Park                        eaed2528-92ff-4fca-bb27-028e2c70a058
#   McKinney Soccer Complex at Craig Ranch    895fdc32-03fb-4bf2-9ce3-d19dad88d5bd
#   Bonnie Wenk Park                          96c185e8-49c1-4f98-b201-482f7960211d
#   Gabe Nesbitt Park                         a1341a60-5d29-450e-be51-cab73a8b420a
#   Grady Littlejohn Sports Complex           22aedc5a-ad62-4ea4-86db-17494fe35031
#   North Park                                952f7879-60e9-4300-931f-e2d53b29d738
PERRY_WEATHER_LOCATION_ID=eaed2528-92ff-4fca-bb27-028e2c70a058
PERRY_WEATHER_LOCATION_NAME="Al Ruschhaupt Park"
